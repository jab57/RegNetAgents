# RegNetAgents - Environment Configuration
# Copy this file to .env and customize for your environment

# ============================================================
# LLM Provider Selection
# ============================================================

# Choose your LLM provider: ollama, openai, anthropic
# - ollama: Free, runs locally (recommended, no API costs)
# - openai: GPT models (requires API key, ~$0.0015 per gene analysis)
# - anthropic: Claude models (requires API key, ~$0.003 per gene analysis)
LLM_PROVIDER=ollama

# Enable/disable LLM-powered agents (true/false)
# Default is 'false' — system runs on fast rule-based categorical assessments without any LLM.
# Set to 'true' only when you want LLM narrative rationales on top of rule-based outputs.
# IMPORTANT: leave 'false' when used as an MCP server (Claude Desktop, Cursor, Zed) to avoid
# triggering 8B model inference automatically on every query.
USE_LLM_AGENTS=false

# Enable optional LLM cross-domain narrative synthesis (requires USE_LLM_AGENTS=true)
# Generates a plain-text synthesis across all 4 domain agents after contradiction detection.
USE_LLM_RECONCILIATION=false

# ============================================================
# Ollama Configuration (DEFAULT: Local, FREE: Cloud)
# ============================================================

# OPTION A: Local Ollama (DEFAULT - Recommended)
# - Runs on your machine (requires Ollama installed)
# - Completely free, unlimited usage
# - No API key needed
# - Models: llama3.1:8b (recommended), mistral:7b, phi3:mini
#
# Setup:
#   1. Install from https://ollama.com/download
#   2. Run: ollama pull llama3.1:8b
#   3. Leave OLLAMA_API_KEY commented out (don't set it)

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# OPTION B: Ollama Cloud (OPTIONAL - Free Tier Available)
# - Runs on Ollama's servers
# - Free tier: 5 premium requests/month for models like Gemini
# - Requires API key from https://ollama.com/settings
# - Models: gemini-3-flash-preview, deepseek-v3, qwen3, etc.
#
# Setup:
#   1. Get API key from https://ollama.com/settings
#   2. Uncomment OLLAMA_API_KEY below and add your key
#   3. Set OLLAMA_MODEL to a cloud model (e.g., gemini-3-flash-preview)
#
# IMPORTANT: Never commit your actual API key! Keep it in .env (gitignored)

# OLLAMA_API_KEY=your-ollama-cloud-key-here
# OLLAMA_MODEL=gemini-3-flash-preview

# Note: If OLLAMA_API_KEY is set, the system automatically uses Ollama Cloud.
# If OLLAMA_API_KEY is not set, the system uses local Ollama (default).

# ============================================================
# Cloud LLM Providers (when LLM_PROVIDER != ollama)
# ============================================================
#
# Shared key and model vars used by openai, anthropic, and openai_compatible providers.
# IMPORTANT: Never commit your actual API key! Keep it in .env (gitignored)

# LLM_API_KEY=your-api-key-here

# Override the model for the selected provider:
# - openai:            gpt-4o-mini  (default)
# - anthropic:         claude-haiku-4-5-20251001  (default)
# - openai_compatible: depends on service
# LLM_MODEL=gpt-4o-mini

# For openai_compatible providers, set the API base URL:
# LLM_API_BASE=https://api.groq.com/openai/v1
# LLM_API_BASE=https://api.together.xyz/v1
# LLM_API_BASE=http://localhost:1234/v1   # LM Studio

# ============================================================
# Performance Tuning
# ============================================================

# Timeout for LLM calls (seconds)
# Recommended: 90 for parallel multi-gene analysis, 30 for single genes
OLLAMA_TIMEOUT=90

# Temperature for LLM inference (0.0-1.0)
# Lower = more deterministic, higher = more creative
# Recommended: 0.3 for scientific analysis
OLLAMA_TEMPERATURE=0.3

# Maximum tokens for LLM response
OLLAMA_MAX_TOKENS=1500

# ============================================================
# Notes
# ============================================================
#
# Default mode (USE_LLM_AGENTS=false):
#   - Runs entirely on rule-based categorical assessments (instant, no LLM)
#   - Domain agents return high/moderate/low assessments with evidence factors
#   - Cross-domain contradiction detection runs automatically
#   - Recommended for MCP clients (Claude Desktop, Cursor, Zed)
#
# To enable Ollama LLM rationales:
#   1. Install Ollama: https://ollama.com/download
#   2. Pull model: ollama pull llama3.1:8b
#   3. Set USE_LLM_AGENTS=true in this file
#   Ollama runs as background service (no manual start needed after install)
#
# To enable a cloud LLM provider:
#   1. Set LLM_PROVIDER=openai (or anthropic / openai_compatible)
#   2. Set LLM_API_KEY=your-key
#   3. Optionally set LLM_MODEL and LLM_API_BASE
#   4. Set USE_LLM_AGENTS=true
